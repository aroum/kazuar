<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <profileable android:shell="true" />
        <!-- Macrobenchmark force-stops the IME between measurements. Its boot receiver
             otherwise kills the process when Android has switched to the fallback IME. -->
        <receiver android:name="io.github.aroum.kazuar.inputmethod.latin.SystemBroadcastReceiver"
            android:enabled="false" tools:replace="android:enabled" />
        <activity android:name=".performance.BenchmarkEditorActivity"
            android:exported="true" android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
    </application>
</manifest>
