<?xml version="1.0" encoding="utf-8"?>
<!-- XML layout sets/rows, dictionary names, subtype labels, accessibility descriptions
     and !string references are resolved by name at runtime. Keep their transitive assets. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@xml/*,@raw/*,@string/subtype_*,@string/spoken_*,@string/label_*" />
