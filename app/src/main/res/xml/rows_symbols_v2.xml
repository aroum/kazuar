<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <include
        latin:keyboardLayout="@xml/key_styles_common" />

    <!-- Row 1 -->
    <Row latin:keyWidth="10%p">
        <Key latin:keySpec="!" />
        <Key latin:keySpec="@" />
        <Key latin:keySpec="&#x2116;" />
        <Key latin:keySpec="$" />
        <Key latin:keySpec="%" latin:moreKeys="\\%,&#x00B0;" />
        <Key latin:keySpec="^" />
        <Key latin:keySpec="?" />
        <Key latin:keySpec="*" />
        <Key latin:keySpec="(" />
        <Key latin:keySpec=")" />
    </Row>

    <!-- Row 2 -->
    <Row latin:keyWidth="10%p">
        <Key latin:keySpec="~" />
        <Key latin:keySpec="&quot;" />
        <Key latin:keySpec="#" />
        <Key latin:keySpec=":" />
        <Key latin:keySpec=";" />
        <Key latin:keySpec="↷|!code/key_redo" latin:keyLabelFlags="preserveCase" latin:backgroundType="functional" />
        <Key latin:keySpec="_" />
        <Key latin:keySpec="+" />
        <Key latin:keySpec="[{«|[" latin:moreKeys="[,{,«" />
        <Key latin:keySpec="]}»|]" latin:moreKeys="],},»" />
    </Row>

    <!-- Row 3 -->
    <Row latin:keyWidth="10%p">
        <Key latin:keySpec="`" />
        <Key latin:keySpec="'" />
        <Key latin:keySpec="&amp;" />
        <Key latin:keySpec=";" />
        <Key latin:keySpec="/" />
        <Key latin:keySpec="\\\\\\||\\\\" latin:moreKeys="\\\\,|" />
        <Key latin:keySpec="/" />
        <Key latin:keySpec="-" />
        <Key latin:keySpec="=" />
        <Key latin:keyStyle="deleteKeyStyle" latin:keyWidth="10%p" />
    </Row>

    <!-- Row 4 -->
    <Row latin:keyWidth="10%p">
        <Key latin:keySpec="↶|!code/key_undo" latin:keyLabelFlags="preserveCase" latin:backgroundType="functional" />
        <Key latin:keySpec="Cut|!code/key_cut" latin:keyLabelFlags="preserveCase" latin:backgroundType="functional" />
        <Key latin:keySpec="Copy|!code/key_copy" latin:keyLabelFlags="preserveCase" latin:backgroundType="functional" />
        <Key latin:keySpec="⎘|!code/key_paste" latin:keyLabelFlags="preserveCase" latin:backgroundType="functional" />
        <Key latin:keyStyle="spaceKeyStyle" latin:keyWidth="20%p" />
        <Key latin:keySpec="&lt;" />
        <Key latin:keySpec="&gt;" />
        <Key latin:keySpec="," />
        <Key latin:keySpec="." />
    </Row>
</merge>
