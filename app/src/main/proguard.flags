# Keep classes and methods that have the @UsedForTesting annotation
-keep @io.github.sds100.keymapper.inputmethod.annotations.UsedForTesting class *
-keepclassmembers class * {
    @io.github.sds100.keymapper.inputmethod.annotations.UsedForTesting *;
}

# Keep classes and methods that have the @ExternallyReferenced annotation
-keep @io.github.sds100.keymapper.inputmethod.annotations.ExternallyReferenced class *
-keepclassmembers class * {
    @io.github.sds100.keymapper.inputmethod.annotations.ExternallyReferenced *;
}

# Keep native methods
-keepclassmembers class * {
    native <methods>;
}

# Keep classes that are used as a parameter type of methods that are also marked as keep
# to preserve changing those methods' signature.
-keep class io.github.sds100.keymapper.inputmethod.latin.AssetFileAddress
-keep class io.github.sds100.keymapper.inputmethod.latin.Dictionary
-keep class io.github.sds100.keymapper.inputmethod.latin.NgramContext
-keep class io.github.sds100.keymapper.inputmethod.latin.makedict.ProbabilityInfo
-keep class io.github.sds100.keymapper.inputmethod.latin.utils.LanguageModelParam

# Keep classes and members referenced by JNI and core keyboard logic
-keep class io.github.sds100.keymapper.inputmethod.keyboard.KeyboardLayout { *; }
-keep class io.github.sds100.keymapper.inputmethod.keyboard.ProximityInfo { *; }
-keep class io.github.sds100.keymapper.inputmethod.latin.BinaryDictionary { *; }
-keep class io.github.sds100.keymapper.inputmethod.latin.utils.BinaryDictionaryUtils { *; }
-keep class io.github.sds100.keymapper.inputmethod.latin.DicTraverseSession { *; }
-keep class io.github.sds100.keymapper.inputmethod.latin.utils.WordInputEventForPersonalization { *; }
-keep class io.github.sds100.keymapper.inputmethod.latin.ExpandableBinaryDictionary { *; }
-keep class io.github.sds100.keymapper.inputmethod.latin.personalization.UserHistoryDictionary { *; }
-keep class io.github.sds100.keymapper.inputmethod.latin.UserBinaryDictionary { *; }
-keep class io.github.sds100.keymapper.inputmethod.latin.ContactsBinaryDictionary { *; }

# Keep InputMethodService and Activity components
-keep public class * extends android.inputmethodservice.InputMethodService
-keep public class * extends android.app.Activity
-keep public class * extends android.app.Service
-keep public class * extends android.content.BroadcastReceiver
-keep public class * extends android.view.View {
    public <init>(android.content.Context);
    public <init>(android.content.Context, android.util.AttributeSet);
    public <init>(android.content.Context, android.util.AttributeSet, int);
}

# Keep preference classes used via XML reflection
-keep public class * extends androidx.preference.Preference
-keep public class * extends android.preference.Preference

# Strip debug logging calls in optimized builds
-assumenosideeffects class android.util.Log {
    public static boolean isLoggable(java.lang.String, int);
    public static int v(...);
    public static int d(...);
}

# Disable obfuscation to keep stack traces readable and prevent reflection/JNI mismatches
-dontobfuscate

# Keep all keymapper classes and members
-keep class io.github.sds100.keymapper.** { *; }
